{
  "name": "artesana/presupuestador",
  "description": "Costos, recetas y presupuestos para pasteleria artesanal",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "brick/math": "^0.14",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.0 || ^4.0",
    "doctrine/orm": "^3.0",
    "dompdf/dompdf": "^3.1",
    "easycorp/easyadmin-bundle": "^5.0",
    "symfony/asset-mapper": "^8.0",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/expression-language": "^8.0",
    "symfony/flex": "^2.0",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/password-hasher": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/yaml": "^8.0",
    "twig/extra-bundle": "^3.0"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/maker-bundle": "^1.0",
    "symfony/phpunit-bridge": "^8.0"
  },
  "config": {
    "allow-plugins": {"symfony/flex": true, "symfony/runtime": true},
    "sort-packages": true,
    "audit": {"block-insecure": false}
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  },
  "extra": {"symfony": {"allow-contrib": false, "require": "8.*"}}
}
